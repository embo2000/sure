<div id="questrade-providers-panel" class="space-y-4">
  <% items = local_assigns[:questrade_items] || @questrade_items || Current.family.questrade_items.active.ordered %>
  <% active_items = items.respond_to?(:active) ? items.active : items %>

  <% if active_items.blank? %>
    <%= render "settings/providers/setup_steps",
               eyebrow: t("questrade_items.panel.eyebrow"),
               steps: [
                 t("questrade_items.panel.steps.s1_html").html_safe,
                 t("questrade_items.panel.steps.s2"),
                 t("questrade_items.panel.steps.s3_html").html_safe,
                 t("questrade_items.panel.steps.s4"),
                 t("questrade_items.panel.steps.s5"),
                 t("questrade_items.panel.steps.s6")
               ],
               help: { url: "https://www.questrade.com/api/documentation/getting-started", text: t("questrade_items.panel.help_text") } %>
  <% end %>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <%= render DS::Alert.new(message: error_msg, variant: :error) %>
  <% end %>

  <% if active_items.any? %>
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 bg-success rounded-full shrink-0"></div>
      <p class="text-sm text-secondary"><%= t("questrade_items.panel.status_configured_html", accounts_path: accounts_path).html_safe %></p>
    </div>
    <p class="text-xs text-secondary"><%= t("questrade_items.panel.token_refresh_hint") %></p>

    <div class="space-y-3">
      <% active_items.each do |item| %>
        <%= render DS::Disclosure.new(variant: :card, open: active_items.one?) do |disclosure| %>
          <% disclosure.with_summary_content do %>
            <div class="flex items-center justify-between gap-2 w-full">
              <div class="flex items-center gap-3">
                <%= render ProviderLogo.new(provider_key: :questrade) %>
                <div>
                  <p class="font-medium text-primary"><%= item.name %></p>
                  <p class="text-xs text-secondary"><%= item.sync_status_summary %></p>
                </div>
              </div>
            </div>
          <% end %>

          <div class="mt-4 space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <%= render DS::Button.new(
                text: t("questrade_items.panel.sync"),
                icon: "refresh-cw",
                variant: :outline,
                href: sync_questrade_item_path(item),
                method: :post,
                disabled: item.syncing?
              ) %>
              <%= render DS::Button.new(
                text: t("questrade_items.panel.disconnect"),
                icon: "trash-2",
                variant: :outline_destructive,
                href: questrade_item_path(item),
                method: :delete,
                aria: { label: t("questrade_items.panel.disconnect_label", name: item.name) },
                confirm: t("questrade_items.panel.disconnect_confirm_named", name: item.name)
              ) %>
            </div>

            <%= styled_form_with model: item,
                                 url: questrade_item_path(item),
                                 scope: :questrade_item,
                                 method: :patch,
                                 data: { turbo: true },
                                 class: "space-y-3" do |form| %>
              <%= form.text_field :name,
                                  label: t("questrade_items.panel.connection_name_label"),
                                  placeholder: t("questrade_items.panel.connection_name_placeholder") %>

              <%= form.text_field :refresh_token,
                                  label: t("questrade_items.panel.fields.refresh_token.label"),
                                  placeholder: t("questrade_items.panel.fields.refresh_token.placeholder_update"),
                                  type: :password,
                                  value: nil %>

              <div class="flex justify-end gap-2">
                <%= render DS::Link.new(
                  text: t("questrade_items.panel.setup_accounts"),
                  icon: "settings",
                  variant: "secondary",
                  href: setup_accounts_questrade_item_path(item),
                  frame: :modal
                ) %>
                <%= render DS::Button.new(text: t("questrade_items.panel.update_button"), type: "submit") %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= render "settings/providers/add_connection_heading", label: t("questrade_items.panel.add_connection") %>
  <% end %>

  <% new_item = Current.family.questrade_items.build %>
  <%= styled_form_with model: new_item,
                       url: questrade_items_path,
                       scope: :questrade_item,
                       method: :post,
                       data: { turbo: true },
                       class: "space-y-3" do |form| %>
    <%= form.text_field :name,
                        label: t("questrade_items.panel.connection_name_label"),
                        placeholder: t("questrade_items.panel.connection_name_placeholder") %>

    <%= form.text_field :refresh_token,
                        label: t("questrade_items.panel.fields.refresh_token.label"),
                        placeholder: t("questrade_items.panel.fields.refresh_token.placeholder_new"),
                        type: :password,
                        value: nil %>

    <div class="flex justify-end">
      <%= form.submit(active_items.any? ? t("questrade_items.panel.add_connection") : t("questrade_items.panel.save_button")) %>
    </div>
  <% end %>
</div>
